"@using System.Globalization
@model YaziciTakip.Models.DailySummaryViewModel
@{
    ViewData["Title"] = "Rapor";
    var tr = new CultureInfo("tr-TR");
    string N(long v) => v.ToString("N0", tr);

    var fromStr = Model.From.ToString("yyyy-MM-dd");
    var toStr = Model.To.ToString("yyyy-MM-dd");
    var last7 = new { from = Model.To.AddDays(-6).ToString("yyyy-MM-dd"), to = toStr };
    var last30 = new { from = Model.To.AddDays(-29).ToString("yyyy-MM-dd"), to = toStr };
    var last90 = new { from = Model.To.AddDays(-89).ToString("yyyy-MM-dd"), to = toStr };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">Rapor</h1>
        <div class="text-muted small">Seçilen tarih aralığında alınan okumalar ve basılan sayfa toplamları</div>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="Readings" asp-action="Index">Sayaç oku</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label for="from" class="form-label">Başlangıç</label>
        <input type="date" id="from" name="from" value="@fromStr" class="form-control" />
    </div>
    <div class="col-auto">
        <label for="to" class="form-label">Bitiş</label>
        <input type="date" id="to" name="to" value="@toStr" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Göster</button>
    </div>
    <div class="col-auto">
        <a class="btn btn-outline-secondary" asp-action="Summary" asp-route-from="@last7.from" asp-route-to="@last7.to">Son 7 gün</a>
        <a class="btn btn-outline-secondary" asp-action="Summary" asp-route-from="@last30.from" asp-route-to="@last30.to">Son 30 gün</a>
        <a class="btn btn-outline-secondary" asp-action="Summary" asp-route-from="@last90.from" asp-route-to="@last90.to">Son 90 gün</a>
    </div>
</form>

@if (Model.ReadingsTotal == 0)
{
    <div class="alert alert-info">
        <strong>@Model.From.ToString("dd.MM.yyyy") – @Model.To.ToString("dd.MM.yyyy")</strong> aralığında kayıtlı okuma yok.
        <a asp-controller="Readings" asp-action="Index">Sayaç Oku</a> sayfasından bir okuma alın.
    </div>
    return;
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="card metric-card h-100"><div class="card-body">
            <div class="metric-label">Dönem toplamı</div>
            <div class="metric-value">@N(Model.GrandTotal)</div>
            <div class="metric-sub">@Model.From.ToString("dd.MM.yyyy") – @Model.To.ToString("dd.MM.yyyy")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card metric-card h-100"><div class="card-body">
            <div class="metric-label">Okuma sayısı</div>
            <div class="metric-value">@Model.ReadingsTotal</div>
            <div class="metric-sub">@Model.Printers.Count yazıcı</div>
        </div></div>
    </div>
</div>

@if (Model.PrinterTotals.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">Yazıcı bazında dönem toplamı</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead>
                        <tr><th>Yazıcı</th><th class="text-end">Basılan sayfa</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Printers)
                    {
                        var pt = Model.PrinterTotals.TryGetValue(p.Id, out var v) ? v : 0;
                        <tr>
                            <td class="fw-semibold">@p.Name</td>
                            <td class="text-end @(pt > 0 ? "" : "text-muted")">@(pt > 0 ? N(pt) : "–")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Toplam</th>
                            <th class="text-end">@N(Model.GrandTotal)</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span>Okumalar</span>
        <span class="d-flex align-items-center gap-2">
            <span class="text-muted small">
                @(Model.ShowAllReadings
                    ? $"{Model.ReadingsTotal} okuma"
                    : $"son {Model.Readings.Count} / {Model.ReadingsTotal} okuma")
            </span>
            @if (Model.ShowAllReadings)
            {
                <a class="btn btn-outline-secondary btn-sm"
                   asp-action="Summary" asp-route-from="@fromStr" asp-route-to="@toStr">Sadece son okumalar</a>
            }
            else if (Model.ReadingsTotal > Model.Readings.Count)
            {
                <a class="btn btn-outline-secondary btn-sm"
                   asp-action="Summary" asp-route-from="@fromStr" asp-route-to="@toStr" asp-route-all="true">Tümünü göster</a>
            }
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height:34rem;overflow-y:auto">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead style="position:sticky;top:0;background:#f8fafc;z-index:1">
                    <tr>
                        <th>Zaman</th>
                        <th>Yazıcı</th>
                        <th class="text-end">Sayaç</th>
                        <th class="text-end">Fark</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Readings)
                {
                    <tr>
                        <td class="text-nowrap">@r.TimestampUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm", tr)</td>
                        <td class="fw-semibold">@r.PrinterName</td>
                        <td class="text-end">@N(r.PageCount)</td>
                        <td class="text-end">
                            @if (r.Delta is { } d)
                            {
                                <span class="@(d > 0 ? "fw-semibold" : "text-muted")">@(d > 0 ? "+" + N(d) : "0")</span>
                            }
                            else
                            {
                                <span class="text-muted">–</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">
        “Fark” bir önceki okumaya göredir. “–” ilk okuma ya da sayaç geriye gitmiş demektir.
    </div>
</div>
