@using System.Globalization
@model YaziciTakip.Models.LifetimeViewModel
@{
    ViewData["Title"] = "Ömür Boyu Sayaç";
    var tr = new CultureInfo("tr-TR");
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="mb-0">Ömür Boyu Sayaç</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Summary">Günlük özete dön</a>
</div>

<div class="alert alert-info">
    Yazıcının SNMP sayacı (Printer-MIB) <strong>dahili ve ömür boyu kümülatiftir</strong> — yazıcı üretildiğinden/sıfırlandığından
    beri bastığı <em>tüm</em> sayfaları sayar, sadece bu sistemi kurduğumuzdan beri basılanları değil.
    Bu yüzden aşağıdaki <strong>"İlk okumadaki sayaç"</strong> değeri, izlemeye başlamadan <u>önce</u> o yazıcının bastığı
    toplam sayfa sayısını zaten içeriyor. "Güncel sayaç" ise yazıcının bugüne kadarki toplamıdır.
</div>

@if (!Model.AnyData)
{
    <div class="alert alert-warning">
        Henüz hiçbir yazıcıdan okuma yapılmamış. En az bir SNMP okuması gerçekleştikten sonra bu sayfa
        yazıcıların ömür boyu sayaç değerlerini gösterecek.
    </div>
    return;
}

<div class="table-responsive">
    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Yazıcı</th>
                <th>IP</th>
                <th>İlk okuma tarihi<br /><span class="fw-normal text-muted">(izleme başlangıcı)</span></th>
                <th class="text-end">İlk okumadaki sayaç<br /><span class="fw-normal text-muted">(izleme öncesi dahil, ömür boyu)</span></th>
                <th>Son okuma tarihi</th>
                <th class="text-end">Güncel sayaç<br /><span class="fw-normal text-muted">(bugüne kadar, ömür boyu)</span></th>
                <th class="text-end">İzleme süresince basılan</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Printers)
        {
            <tr>
                <td>@p.PrinterName</td>
                <td class="text-muted">@p.IpAddress</td>
                @if (!p.HasReadings)
                {
                    <td colspan="5" class="text-muted">Henüz okuma yok</td>
                }
                else
                {
                    <td>@p.FirstReadingUtc!.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end fw-bold">@p.FirstCounter!.Value.ToString("N0", tr)</td>
                    <td>@p.LatestReadingUtc!.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-end fw-bold">@p.LatestCounter!.Value.ToString("N0", tr)</td>
                    <td class="text-end">
                        @(p.PagesSinceMonitoringStarted is { } d && d >= 0 ? d.ToString("N0", tr) : "–")
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>

<p class="text-muted small">
    Not: "İzleme süresince basılan" negatif ya da anlamsız çıkıyorsa, sayaç bu aralıkta sıfırlanmış
    (yazıcı bakımı/resetlenmesi) olabilir — bu durumda ilk ve son okuma farklı bir sayaç dönemine ait demektir.
</p>
