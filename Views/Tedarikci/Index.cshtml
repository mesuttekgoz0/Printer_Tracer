@using System.Globalization
@model List<YaziciTakip.Controllers.TedarikciListRow>
@{
    ViewData["Title"] = "Tedarikçiler";
    var tr = new CultureInfo("tr-TR");
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">Tedarikçiler</h1>
        <div class="text-muted small">Yazıcı servis/bayi firmaları ve tarihli sayfa-başı fiyat listeleri. Yazıcı–tedarikçi eşleşmesi <a asp-controller="Printers" asp-action="Index">Yazıcılar</a> sayfasından yapılır.</div>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card mb-4">
    <div class="card-header">Yeni tedarikçi ekle</div>
    <div class="card-body">
        <form method="post" asp-action="Create" class="row g-2 align-items-end">
            <div class="col-auto">
                <label for="ad" class="form-label">Tedarikçi adı</label>
                <input type="text" id="ad" name="ad" class="form-control" placeholder="ör. Olivetti Servis" required style="min-width:14rem" />
            </div>
            <div class="col-auto flex-grow-1">
                <label for="not" class="form-label">Not (opsiyonel)</label>
                <input type="text" id="not" name="not" class="form-control" maxlength="500" placeholder="iletişim, sözleşme no…" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Ekle</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">Kayıtlı tedarikçiler</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>Not</th>
                        <th class="text-end">Yazıcı</th>
                        <th class="text-end">Fiyat listesi</th>
                        <th>Son liste tarihi</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="p-4 text-center text-muted">Henüz tedarikçi yok. Yukarıdaki formdan ekleyin.</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-semibold">@t.Ad</td>
                        <td class="text-muted small">@(string.IsNullOrWhiteSpace(t.Not) ? "–" : t.Not)</td>
                        <td class="text-end">@t.PrinterCount</td>
                        <td class="text-end">
                            @if (t.PriceListCount == 0)
                            {
                                <span class="text-danger" title="Fiyat listesi yok — hakediş tutarları 0 gelir">0</span>
                            }
                            else
                            {
                                @t.PriceListCount
                            }
                        </td>
                        <td class="text-muted small">@(t.LatestPriceListDate is { } d ? d.ToString("dd.MM.yyyy") : "–")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@t.Id">Aç / Düzenle</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
