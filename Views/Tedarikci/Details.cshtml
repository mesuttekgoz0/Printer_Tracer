@using System.Globalization
@model YaziciTakip.Controllers.TedarikciDetailsViewModel
@{
    var t = Model.Tedarikci;
    ViewData["Title"] = t.Ad;
    var inv = CultureInfo.InvariantCulture;
    string InpFiyat(decimal v) => v.ToString("0.####", inv);
    var today = DateOnly.FromDateTime(DateTime.Now);
    var currentListId = t.FiyatListeleri
        .Where(x => x.Tarih <= today)
        .OrderByDescending(x => x.Tarih).ThenByDescending(x => x.Id)
        .Select(x => (int?)x.Id)
        .FirstOrDefault();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">@t.Ad</h1>
        <div class="text-muted small">Tedarikçi bilgileri, bağlı yazıcılar ve fiyat listeleri.</div>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">← Tedarikçiler</a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header">Tedarikçi bilgileri</div>
            <div class="card-body">
                <form method="post" asp-action="Edit" asp-route-id="@t.Id" class="vstack gap-2">
                    <div>
                        <label class="form-label" for="ad">Ad</label>
                        <input type="text" id="ad" name="ad" class="form-control" value="@t.Ad" required />
                    </div>
                    <div>
                        <label class="form-label" for="not">Not</label>
                        <input type="text" id="not" name="not" class="form-control" maxlength="500" value="@t.Not" />
                    </div>
                    <div>
                        <button type="submit" class="btn btn-primary btn-sm">Kaydet</button>
                    </div>
                </form>
                <hr />
                <form method="post" asp-action="Delete" asp-route-id="@t.Id"
                      onsubmit="return confirm('@t.Ad silinsin mi? Bağlı yazıcıların tedarikçi bağı kaldırılır, fiyat listeleri silinir. Geçmiş hakedişler etkilenmez.');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Tedarikçiyi sil</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Bağlı yazıcılar (@t.Printers.Count)</div>
            <div class="card-body p-0">
                @if (t.Printers.Count == 0)
                {
                    <div class="p-3 text-muted small">
                        Bu tedarikçiye bağlı yazıcı yok.
                        <a asp-controller="Printers" asp-action="Index">Yazıcılar</a> sayfasından atayın.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var p in t.Printers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@p.Name <span class="text-muted small">· @p.IpAddress</span></span>
                                <span class="badge text-bg-light border">@p.TurAdi</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header">Yeni fiyat listesi</div>
            <div class="card-body">
                <form method="post" asp-action="AddPriceList" class="row g-2 align-items-end">
                    <input type="hidden" name="tedarikciId" value="@t.Id" />
                    <div class="col-12 col-sm-5">
                        <label class="form-label" for="listeAdi">Liste adı</label>
                        <input type="text" id="listeAdi" name="listeAdi" class="form-control" placeholder="ör. 2026 sözleşme fiyatı" required />
                    </div>
                    <div class="col-6 col-sm-3">
                        <label class="form-label" for="tarih">Geçerlilik tarihi</label>
                        <input type="date" id="tarih" name="tarih" class="form-control" value="@today.ToString("yyyy-MM-dd")" />
                    </div>
                    @foreach (var tur in Model.Turler)
                    {
                        <div class="col-6 col-sm-2">
                            <label class="form-label">@tur.Ad ₺/sayfa</label>
                            <input type="hidden" name="turId" value="@tur.Id" />
                            <input type="text" inputmode="decimal" name="fiyat" class="form-control text-end" placeholder="0,00" />
                        </div>
                    }
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary btn-sm mt-1">Fiyat listesi ekle</button>
                    </div>
                </form>
                <div class="form-text mt-2">
                    Hakediş üretilirken, dönem bitiş tarihine göre <strong>en güncel</strong> fiyat listesi kullanılır.
                    Ondalık için virgül veya nokta kabul edilir.
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Fiyat listeleri (@t.FiyatListeleri.Count)</div>
            <div class="card-body p-0">
                @if (t.FiyatListeleri.Count == 0)
                {
                    <div class="p-3 text-danger small">Fiyat listesi yok — bu tedarikçi için hakediş tutarları 0 hesaplanır.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="min-width:11rem">Liste adı</th>
                                    <th>Tarih</th>
                                    @foreach (var tur in Model.Turler)
                                    {
                                        <th class="text-end">@tur.Ad ₺</th>
                                    }
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var f in t.FiyatListeleri)
                            {
                                <tr>
                                    <td>
                                        <form id="pl-@f.Id" method="post" asp-action="EditPriceList" asp-route-id="@f.Id"></form>
                                        <input form="pl-@f.Id" type="text" name="listeAdi" value="@f.ListeAdi" required
                                               class="form-control form-control-sm" />
                                        @if (f.Id == currentListId)
                                        {
                                            <span class="badge text-bg-success mt-1 d-inline-block">güncel</span>
                                        }
                                    </td>
                                    <td>
                                        <input form="pl-@f.Id" type="date" name="tarih" value="@f.Tarih.ToString("yyyy-MM-dd")"
                                               class="form-control form-control-sm" />
                                    </td>
                                    @foreach (var tur in Model.Turler)
                                    {
                                        <td>
                                            <input form="pl-@f.Id" type="hidden" name="turId" value="@tur.Id" />
                                            <input form="pl-@f.Id" type="text" inputmode="decimal" name="fiyat"
                                                   value="@InpFiyat(f.FiyatBul(tur.Id))" class="form-control form-control-sm text-end" />
                                        </td>
                                    }
                                    <td class="text-end text-nowrap">
                                        <button form="pl-@f.Id" type="submit" class="btn btn-sm btn-outline-secondary">Kaydet</button>
                                        <form method="post" asp-action="DeletePriceList" asp-route-id="@f.Id" class="d-inline"
                                              onsubmit="return confirm('@f.ListeAdi listesi silinsin mi?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
