@using System.Globalization
@model YaziciTakip.Controllers.PrintersIndexViewModel
@{
    ViewData["Title"] = "Yazıcılar";
    var tr = new CultureInfo("tr-TR");
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="mb-0">Yazıcılar</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="Report" asp-action="Summary">Rapora dön</a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card mb-4">
    <div class="card-header">Yeni yazıcı ekle</div>
    <div class="card-body">
        <form method="post" asp-controller="Printers" asp-action="Create" class="row g-2 align-items-end">
            <div class="col-auto">
                <label for="name" class="form-label">Yazıcı adı</label>
                <input type="text" id="name" name="name" class="form-control" placeholder="ör. Muhasebe" required style="min-width:12rem" />
            </div>
            <div class="col-auto">
                <label for="ipAddress" class="form-label">IP adresi</label>
                <input type="text" id="ipAddress" name="ipAddress" class="form-control" placeholder="192.168.1.51" required style="min-width:12rem" />
            </div>
            <div class="col-auto">
                <label for="turId" class="form-label">Tür</label>
                <select id="turId" name="turId" class="form-select">
                    <option value="">Belirtilmemiş</option>
                    @foreach (var tur in Model.Types)
                    {
                        <option value="@tur.Id">@tur.Ad</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label for="tedarikciId" class="form-label">Tedarikçi</label>
                <select id="tedarikciId" name="tedarikciId" class="form-select">
                    <option value="">—</option>
                    @foreach (var s in Model.Suppliers)
                    {
                        <option value="@s.Id">@s.Ad</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Ekle</button>
            </div>
        </form>
        <div class="form-text mt-2">
            Eklemeden önce IP'nin doğru olduğundan emin olmak isterseniz
            <a asp-controller="Diagnostics" asp-action="Index">SNMP Tanılama</a> sayfasından test edebilirsiniz.
            Yazıcı eklendiğinde otomatik okuma yapılmaz; ilk sayaç değeri için
            <a asp-controller="Readings" asp-action="Index">Sayaç Oku</a> sayfasından okuma alın.
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">Kayıtlı yazıcılar</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>IP adresi</th>
                        <th>Tür</th>
                        <th>Tedarikçi</th>
                        <th class="text-end">Okuma sayısı</th>
                        <th>Son okuma</th>
                        <th class="text-end">Son sayaç</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Printers.Count == 0)
                {
                    <tr><td colspan="8" class="p-4 text-center text-muted">Henüz kayıtlı yazıcı yok. Yukarıdaki formdan ekleyebilirsiniz.</td></tr>
                }
                @foreach (var p in Model.Printers)
                {
                    <tr>
                        <td>
                            <form method="post" asp-controller="Printers" asp-action="Rename" asp-route-id="@p.Id" class="d-flex gap-1">
                                <input type="text" name="name" value="@p.Name" class="form-control form-control-sm" style="min-width:9rem" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Adı kaydet">Kaydet</button>
                            </form>
                        </td>
                        <td class="text-muted"><code>@p.IpAddress</code></td>
                        <td>
                            <form method="post" asp-controller="Printers" asp-action="SetType" asp-route-id="@p.Id">
                                <select name="turId" class="form-select form-select-sm" style="min-width:8.5rem"
                                        onchange="this.form.submit()" title="Yazıcı türünü değiştir">
                                    <option value="" selected="@(p.TurId is null)">Belirtilmemiş</option>
                                    @foreach (var tur in Model.Types)
                                    {
                                        <option value="@tur.Id" selected="@(p.TurId == tur.Id)">@tur.Ad</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td>
                            <form method="post" asp-controller="Printers" asp-action="SetSupplier" asp-route-id="@p.Id">
                                <select name="tedarikciId" class="form-select form-select-sm" style="min-width:10rem"
                                        onchange="this.form.submit()" title="Tedarikçi ata">
                                    <option value="" selected="@(p.TedarikciId is null)">—</option>
                                    @foreach (var s in Model.Suppliers)
                                    {
                                        <option value="@s.Id" selected="@(p.TedarikciId == s.Id)">@s.Ad</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td class="text-end">@p.ReadingCount.ToString("N0", tr)</td>
                        <td class="text-muted small">@(p.LatestReadingUtc is { } t ? t.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "–")</td>
                        <td class="text-end">@(p.LatestCounter is { } c ? c.ToString("N0", tr) : "–")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Diagnostics" asp-action="Index" asp-route-ip="@p.IpAddress">Test et</a>
                            <form method="post" asp-controller="Printers" asp-action="Delete" asp-route-id="@p.Id" class="d-inline"
                                  onsubmit="return confirm('@p.Name (@p.IpAddress) silinsin mi? Geçmiş okumaları da silinecek.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
