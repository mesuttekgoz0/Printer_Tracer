<!DOCTYPE html>
@{
    var routeData = ViewContext.RouteData.Values;
    var currentController = routeData["controller"] as string;
    var currentAction = routeData["action"] as string;
    string NavActive(string controller, params string[] actions)
        => currentController == controller && (actions.Length == 0 || actions.Contains(currentAction))
            ? "active" : "";
}
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Yazıcı Takip</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/YaziciTakip.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md app-navbar mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">YT</span>
                    Yazıcı Takip
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menü">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Home", "Index")" asp-controller="Home" asp-action="Index">Panel</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Printers")" asp-controller="Printers" asp-action="Index">Yazıcılar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Report")" asp-controller="Report" asp-action="Summary">Günlük Özet</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Diagnostics")" asp-controller="Diagnostics" asp-action="Index">SNMP Tanılama</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year Yazıcı Takip
            <a asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
