@model List<YaziciTakip.Controllers.TedarikciSecRow>
@{
    ViewData["Title"] = "Yeni Hakediş";
    var seçilebilir = Model.Where(t => t.PrinterCount > 0).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">Yeni Hakediş</h1>
        <div class="text-muted small">Tedarikçi seçin; o tedarikçinin tüm yazıcıları için hakediş taslağı hazırlanır.</div>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">← Hakedişler</a>
</div>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        Henüz tedarikçi yok. <a asp-controller="Tedarikci" asp-action="Index">Tedarikçiler</a> sayfasından ekleyin,
        sonra <a asp-controller="Printers" asp-action="Index">Yazıcılar</a> sayfasından yazıcılara tedarikçi atayın.
    </div>
}
else
{
    <div class="card" style="max-width:32rem">
        <div class="card-body">
            <form method="post" asp-action="Create" class="vstack gap-3">
                <div>
                    <label class="form-label" for="tedarikciId">Tedarikçi</label>
                    <select id="tedarikciId" name="tedarikciId" class="form-select" required>
                        <option value="" disabled selected>— seçin —</option>
                        @foreach (var t in Model)
                        {
                            <option value="@t.Id" disabled="@(t.PrinterCount == 0)">
                                @t.Ad (@t.PrinterCount yazıcı)@(t.HasPriceList ? "" : " — fiyat listesi yok")
                            </option>
                        }
                    </select>
                    <div class="form-text">Yazıcısı olmayan tedarikçiler seçilemez.</div>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary" @(seçilebilir.Count == 0 ? "disabled" : "")>Devam</button>
                </div>
            </form>
        </div>
    </div>
}
