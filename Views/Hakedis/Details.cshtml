@using System.Globalization
@model YaziciTakip.Models.Hakedis
@{
    ViewData["Title"] = $"Hakediş {Model.Number}";
    var tr = new CultureInfo("tr-TR");
    string N(long v) => v.ToString("N0", tr);
    var fromCompany = ViewData["FromCompany"] as string;
    var toCompany = ViewData["ToCompany"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 d-print-none">
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">← Hakedişler</a>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Csv" asp-route-id="@Model.Id">CSV indir</a>
        <button type="button" class="btn btn-primary btn-sm" onclick="window.print()">Yazdır / PDF</button>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success d-print-none">@ok</div>
}

<div class="card hakedis-doc">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <h1 class="mb-1" style="letter-spacing:.05em">HAKEDİŞ</h1>
                <div class="text-muted">No: <strong>@Model.Number</strong></div>
            </div>
            <div class="text-end small">
                <div>Düzenleme: <strong>@Model.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm", tr)</strong></div>
                <div>Dönem: <strong>@Model.PeriodStart.ToString("dd.MM.yyyy") – @Model.PeriodEnd.ToString("dd.MM.yyyy")</strong></div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(fromCompany) || !string.IsNullOrWhiteSpace(toCompany))
        {
            <div class="row g-3 mb-3 small">
                @if (!string.IsNullOrWhiteSpace(fromCompany))
                {
                    <div class="col-sm-6"><div class="text-muted">Düzenleyen</div><div class="fw-semibold">@fromCompany</div></div>
                }
                @if (!string.IsNullOrWhiteSpace(toCompany))
                {
                    <div class="col-sm-6"><div class="text-muted">Gönderilen</div><div class="fw-semibold">@toCompany</div></div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Note))
        {
            <p class="mb-3"><span class="text-muted">Açıklama:</span> @Model.Note</p>
        }

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead style="background:#f8fafc">
                    <tr>
                        <th class="text-end" style="width:2.5rem">#</th>
                        <th>Yazıcı</th>
                        <th>Marka / Model</th>
                        <th class="text-end">Önceki Sayaç</th>
                        <th class="text-end">Şimdiki Sayaç</th>
                        <th class="text-end">Fark (Sayfa)</th>
                    </tr>
                </thead>
                <tbody>
                @{ var i = 1; }
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td class="text-end text-muted">@(i++)</td>
                        <td class="fw-semibold">@l.PrinterName</td>
                        <td>@(string.IsNullOrWhiteSpace(l.Model) ? "–" : l.Model)</td>
                        <td class="text-end">@N(l.PreviousCounter)</td>
                        <td class="text-end">@N(l.CurrentCounter)</td>
                        <td class="text-end fw-semibold">@(l.Pages is { } p ? N(p) : "?")</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr style="background:#f8fafc">
                        <th colspan="5" class="text-end">TOPLAM</th>
                        <th class="text-end">@N(Model.TotalPages)</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="row mt-5 pt-4">
            <div class="col-6 text-center small text-muted">
                Düzenleyen<br /><br /><br />
                <span style="border-top:1px solid #999;padding:0 3rem">İmza / Kaşe</span>
            </div>
            <div class="col-6 text-center small text-muted">
                Teslim Alan<br /><br /><br />
                <span style="border-top:1px solid #999;padding:0 3rem">İmza / Kaşe</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        @@media print {
            .app-navbar, .footer, .d-print-none { display: none !important; }
            .container { max-width: none; width: 100%; padding: 0; }
            .hakedis-doc, .card { border: none !important; box-shadow: none !important; }
            a[href]:after { content: ""; }
        }
    </style>
}
