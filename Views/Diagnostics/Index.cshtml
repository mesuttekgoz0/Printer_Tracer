@model YaziciTakip.Models.SnmpDiagnosticResult
@{
    ViewData["Title"] = "SNMP Tanılama";
}

<h1 class="mb-3">SNMP Tanılama</h1>
<p class="text-muted">
    Bir yazıcının IP'sini girin; SNMP ile ulaşılıp ulaşılamadığını, model bilgisini ve
    hangi OID'in toplam sayfa sayısını verdiğini gösterir.
</p>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-auto">
        <label for="ip" class="form-label">Yazıcı IP</label>
        <input type="text" id="ip" name="ip" value="@(Model?.IpAddress ?? "")" placeholder="192.168.1.51"
               class="form-control" style="min-width:14rem" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Sorgula</button>
    </div>
</form>

@if (Model is null)
{
    <div class="alert alert-secondary">Sorgu için yukarıya bir IP girin. Girilecek IP ile aynı ağda olmalısınız.</div>
    return;
}

<div class="card mb-3">
    <div class="card-header">Sonuç — @Model.IpAddress</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Ulaşılabilir</dt>
            <dd class="col-sm-9">
                @if (Model.Reachable)
                {
                    <span class="badge bg-success">Evet</span>
                    <span class="ms-2">Yanıt veren sürüm: <strong>@Model.RespondingVersion</strong></span>
                }
                else
                {
                    <span class="badge bg-danger">Hayır</span>
                }
            </dd>
            <dt class="col-sm-3">Model (sysDescr)</dt>
            <dd class="col-sm-9">@(Model.SysDescr ?? "—")</dd>
            <dt class="col-sm-3">Ad (sysName)</dt>
            <dd class="col-sm-9">@(Model.SysName ?? "—")</dd>
            @if (Model.Reachable)
            {
                <dt class="col-sm-3">Tespit edilen marka</dt>
                <dd class="col-sm-9">
                    @if (Model.DetectedBrand is not null)
                    {
                        <span class="badge bg-info text-dark">@Model.DetectedBrand</span>
                    }
                    else
                    {
                        <span class="text-muted">Bilinmiyor</span>
                    }
                </dd>
            }
        </dl>
        @if (Model.Reachable && string.IsNullOrEmpty(Model.SysDescr) && string.IsNullOrEmpty(Model.SysName))
        {
            <p class="text-muted small mb-0 mt-2">
                Yazıcı SNMP'ye yanıt veriyor ama model/ad bilgisini boş döndürdü — bazı yazıcılarda bu alanlar
                kapalı ya da desteklenmiyor olabilir. Bu, sayfa sayacı okumasını etkilemez; marka burada
                belirlenemediği için aşağıda SADECE markadan bağımsız (evrensel) standart OID denenir —
                başka markaya ait OID'ler hiç gösterilmez.
            </p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Özel OID sorgula</div>
    <div class="card-body">
        <p class="text-muted small">
            Bilinen listede olmayan ya da marka otomatik tespit edilemediği için (ör. model/ad bilgisi boş dönen
            cihazlarda) yukarıda gösterilmeyen bir OID'i buradan elle deneyebilirsiniz.
        </p>
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="ip" value="@Model.IpAddress" />
            <div class="col-auto">
                <label for="oid" class="form-label">OID</label>
                <input type="text" id="oid" name="oid" value="@Model.ManualOid" placeholder="1.3.6.1.4.1.1347.42.3.1.2.1.1.1.3"
                       class="form-control" style="min-width:22rem" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Sorgula</button>
            </div>
        </form>
        @if (Model.ManualOid is not null)
        {
            <div class="mt-3">
                @if (Model.ManualOidResult is { } r)
                {
                    <p class="mb-0">
                        <span class="badge bg-success me-2">Yanıt alındı</span>
                        <code>@r.Oid</code> &nbsp;→&nbsp; tip: <strong>@r.Type</strong>, değer: <strong>@r.Value</strong>
                    </p>
                }
                else
                {
                    <span class="badge bg-secondary me-2">Yanıt yok</span>
                    <span class="text-muted small">Cihaz bu OID'i tanımıyor ya da desteklemiyor olabilir.</span>
                }
            </div>
        }
    </div>
</div>

@if (Model.SuggestedOid is not null)
{
    <div class="alert alert-success">
        <strong>Önerilen sayfa sayacı OID'i:</strong>
        <code>@Model.SuggestedOid</code> &nbsp;→&nbsp; değer: <strong>@Model.SuggestedValue</strong><br />
        <span class="small">
            <code>appsettings.json</code> → <code>PrinterMonitoring:Snmp:PageCountOid</code> içine yazıp uygulamayı yeniden başlatın.
        </span>
    </div>
}

@if (Model.Messages.Count > 0)
{
    <ul class="small text-muted">
        @foreach (var m in Model.Messages)
        {
            <li>@m</li>
        }
    </ul>
}

@if (Model.Probes.Count > 0)
{
    <h5 class="mt-4">Denenen bilinen OID'ler</h5>
    <p class="text-muted small">
        Standart satır (<code>Printer-MIB prtMarkerLifeCount</code>) her markada çalışması beklenen evrensel OID'dir,
        her zaman denenir ve test edilen HP, Samsung ve Olivetti yazıcılarda zaten doğru sonucu verdi. Marka
        etiketli satırlar (ör. "HP") SADECE yukarıda o marka tespit edildiyse denenir/gösterilir — başka markanın
        özel OID'leri hiç görünmez. Bu tür etiketler o üreticinin kendi özel OID dalıdır
        (<code>1.3.6.1.4.1.&lt;üretici no&gt;</code> — IANA'nın her üreticiye ayırdığı numara); standart OID zaten
        çalıştığı için genelde gerekmezler, sadece eski/uyumsuz cihazlarda yedek olarak dururlar.
    </p>
    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr><th>OID</th><th>Açıklama</th><th>Tip</th><th class="text-end">Değer</th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Probes)
            {
                <tr class="@(p.IsError ? "" : "table-success")">
                    <td><code>@p.Oid</code></td>
                    <td>@p.Label</td>
                    <td>@(p.Type ?? "—")</td>
                    <td class="text-end">@p.Value</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (Model.MarkerCounters.Count > 0)
{
    <h5 class="mt-4">prtMarkerLifeCount alt ağacı (<code>1.3.6.1.2.1.43.10.2.1.4</code>)</h5>
    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr><th>OID</th><th>Tip</th><th class="text-end">Değer</th></tr>
            </thead>
            <tbody>
            @foreach (var c in Model.MarkerCounters)
            {
                <tr class="@(c.Oid == Model.SuggestedOid ? "table-success fw-bold" : "")">
                    <td><code>@c.Oid</code></td>
                    <td>@c.Type</td>
                    <td class="text-end">@c.Value</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
