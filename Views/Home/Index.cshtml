@using System.Globalization
@model YaziciTakip.Models.DashboardViewModel
@{
    ViewData["Title"] = "Panel";
    var tr = new CultureInfo("tr-TR");
    string Ago(DateTime? utc)
    {
        if (utc is null) return "okuma yok";
        var span = DateTime.UtcNow - utc.Value;
        if (span.TotalMinutes < 1) return "az önce";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} dk önce";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} sa önce";
        return $"{(int)span.TotalDays} gün önce";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">Panel</h1>
        <div class="text-muted small">Yazıcı kullanımına genel bakış</div>
    </div>
    <a class="btn btn-primary btn-sm" asp-controller="Printers" asp-action="Index">Yazıcı ekle</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card metric-card h-100"><div class="card-body">
            <div class="metric-label">Kayıtlı yazıcı</div>
            <div class="metric-value">@Model.PrinterCount</div>
            <div class="metric-sub">&nbsp;</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card metric-card h-100"><div class="card-body">
            <div class="metric-label">Bu ay basılan</div>
            <div class="metric-value">@Model.MonthTotal.ToString("N0", tr)</div>
            <div class="metric-sub">@Model.MonthLabel</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card metric-card h-100"><div class="card-body">
            <div class="metric-label">Bugün basılan</div>
            <div class="metric-value">@Model.TodayTotal.ToString("N0", tr)</div>
            <div class="metric-sub">sayfa</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card metric-card h-100"><div class="card-body">
            <div class="metric-label">Son okuma</div>
            <div class="metric-value" style="font-size:1.25rem">@Ago(Model.LastReadingUtc)</div>
            <div class="metric-sub">
                @(Model.LastReadingUtc is null ? "" : Model.LastReadingUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm", tr))
            </div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Yazıcılar</span>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Report" asp-action="Summary">Günlük özet raporu</a>
    </div>
    <div class="card-body p-0">
        @if (Model.Printers.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                Henüz yazıcı eklenmemiş.
                <a asp-controller="Printers" asp-action="Index">Yazıcılar</a> sayfasından ad ve IP girerek ekleyin.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Yazıcı</th>
                            <th>IP</th>
                            <th class="text-end">Bu ay</th>
                            <th class="text-end">Güncel sayaç</th>
                            <th class="text-end">Son okuma</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Printers)
                    {
                        <tr>
                            <td class="fw-semibold">@p.Name</td>
                            <td class="text-muted"><code>@p.IpAddress</code></td>
                            <td class="text-end">@(p.MonthPages > 0 ? p.MonthPages.ToString("N0", tr) : "–")</td>
                            <td class="text-end">@(p.LatestCounter?.ToString("N0", tr) ?? "–")</td>
                            <td class="text-end text-muted small">@Ago(p.LatestReadingUtc)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
